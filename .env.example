# Required
ANTHROPIC_API_KEY=

# Issue tracker — leave ISSUE_TRACKER_BASE_URL pointing at the local mock for the demo.
# For a real integration, unset ISSUE_TRACKER_BASE_URL and set ISSUE_TRACKER_API_KEY.
ISSUE_TRACKER_BASE_URL=http://localhost:8765
ISSUE_TRACKER_API_KEY=

# Slack — optional. If unset, triage output prints to stdout instead of posting.
SLACK_WEBHOOK_URL=
